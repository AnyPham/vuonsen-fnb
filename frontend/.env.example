# Sao chep file nay thanh .env truoc khi chay `npm run dev`

# Duong dan goc cua API. De trong -> dung proxy cua Vite (khuyen nghi khi phat trien).
VITE_API_BASE_URL=

# Khoa Google Maps JavaScript API (phan hien thi vi tri nha hang)
VITE_GOOGLE_MAPS_API_KEY=

# Toa do nha hang hien tren ban do
VITE_MAP_LAT=10.8231
VITE_MAP_LNG=106.7300

# Cloudinary de tai anh len tu trang quan tri.
# cloud name lay o Dashboard; upload preset phai tao dang unsigned
# trong Settings > Upload > Upload presets.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
