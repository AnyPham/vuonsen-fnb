    {
      "name": "00 - Chuẩn bị",
      "item": [
        {
          "name": "Đăng nhập quản trị",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng nhập thành công\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);",
                  "pm.collectionVariables.set(\"hauTo\", String(Date.now()).slice(-6));"
                ]
              }
            }
          ]
        },
