    {
      "name": "API-NEG - Kiểm thử API ngoại lệ",
      "item": [
        {
          "name": "TC-API-01 Từ chối số lượng món vượt giới hạn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dish-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dish-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fulfillmentType\": \"DELIVERY\",\n  \"customerName\": \"Khách kiểm thử\",\n  \"customerPhone\": \"0901234567\",\n  \"deliveryAddress\": \"12 Nguyễn Huệ, Quận 1\",\n  \"serveAt\": \"{{serveAt}}\",\n  \"items\": [\n    {\n      \"dishId\": \"{{dishId}}\",\n      \"quantity\": 100000\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Trả 400 khi số lượng 100.000 phần\", function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include(\"200\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 5*86400000); d.setHours(11,0,0,0);",
                  "const p = n => String(n).padStart(2,\"0\");",
                  "pm.collectionVariables.set(\"serveAt\", `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T11:00:00`);"
                ]
              }
            }
          ]
        },
